// Cloudflare Workers config. The site is fully prerendered by TanStack Start
// (see vite.config.ts), so the Worker serves static files only — no server
// code. Cloudflare's Git integration runs `npm run build`, then
// `npx wrangler deploy`, which uploads dist/client.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deebuilt-foundations",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    // Serve /about straight from about/index.html, matching the app's own
    // links. /about/ redirects to /about instead of the other way round.
    // Cloudflare's own redirect for that is a temporary 307, so the build adds
    // a permanent 301 for each page to _redirects (vite.config.ts), which
    // Cloudflare applies first.
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get 404.html with a 404 status. The build prerenders it
    // from the /404 route (src/routes/404.tsx). Until 2026-11-15 this was
    // "single-page-application", which answered every made-up address with
    // the homepage and a 200, and search engines read that as soft 404s.
    "not_found_handling": "404-page"
  }
}
